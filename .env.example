# ============================================================
# Gegeen — Environment variables (template)
# Copy to .env.local (apps/web/.env.local for local dev)
# Set values in Vercel dashboard for production.
# ============================================================

# Supabase (find these in Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role — NEVER expose to browser; Edge Functions / Server Actions only
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# QPay merchant credentials (https://qpay.mn for signup)
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Optional: override API base (defaults to https://merchant.qpay.mn/v2)
# QPAY_BASE_URL=https://merchant.qpay.mn/v2
# Optional: Ebarimt 3.0 e-receipts (best-effort after payment; needs QPay to
# enable e-receipt for the merchant). Set "false" to disable. Defaults on.
# QPAY_EBARIMT_ENABLED=true

# Site URL for OAuth redirects + SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Phase 2) Resend for transactional email
RESEND_API_KEY=

# Callpro SMS — https://callpro.mn
CALLPRO_API_URL=
CALLPRO_USER=
CALLPRO_PASSWORD=
CALLPRO_SENDER=GEGEEN
